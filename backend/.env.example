BOT_TOKEN=
WEBAPP_URL=http://localhost:5173
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
INITDATA_MAX_AGE=3600
DB_PATH=./data/finance.db
TIMEZONE=Asia/Jakarta
# Optional AI fallback (OpenAI-compatible). Leave empty to disable.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Optional: separate model for receipt photos (defaults to AI_MODEL)
AI_VISION_MODEL=
AI_PRICE_INPUT_PER_1M=
AI_PRICE_OUTPUT_PER_1M=
AI_PRICE_CURRENCY=IDR

# Admin-switchable presets (MiniMax / GLM / MiMo). Admin picks per role in /admin → Analitik → Konfigurasi AI.
# AI_PRESETS is a JSON array of {id,label,base_url,model,key_ref}. API keys live in AI_KEYS (JSON {key_ref: apiKey}),
# never crossing to the browser. When no override is active, AI_BASE_URL/AI_API_KEY/AI_MODEL above are used.
# AI_PRESETS=[{"id":"minimax-3.1-flash","label":"MiniMax 3.1 Flash","base_url":"https://ai.sumopod.com/v1","model":"MiniMax-M3.1-Flash-Preview","key_ref":"sumopod"}]
# AI_KEYS={"sumopod":"<key>","zhipu":"<key>"}

# Per-task timeouts (ms). Defaults: chat 12000, fallback 6000, receipt 20000, report 20000. Safety cap 60000.
# AI_TIMEOUT_CHAT_MS=
# AI_TIMEOUT_FALLBACK_MS=
# AI_TIMEOUT_RECEIPT_MS=
# AI_TIMEOUT_REPORT_MS=
# AI_TIMEOUT_STT_MS=

# Max output tokens per task (keep small = faster + cheaper). Defaults: chat 400, receipt 500, report 2000.
# AI_MAX_TOKENS_CHAT=
# AI_MAX_TOKENS_RECEIPT=
# AI_MAX_TOKENS_REPORT=

# Subscriptions
TRIAL_DAYS=7
PLAN_TRIAL_AI_LIMIT=20
PLAN_TRIAL_RECEIPT_LIMIT=10
ADMIN_CONTACT=

# Database backups (daily 03:00; see docs/DEPLOY.md). Optional S3-compatible bucket for off-volume copies.
BACKUP_ENABLED=true
BACKUP_KEEP=7
BACKUP_DIR=
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_PATH_STYLE=false

# Admin dashboard (/admin). Generate the hash with: npm run hash-password
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
