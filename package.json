{
  "name": "finance-bot",
  "version": "1.0.0",
  "description": "Telegram Finance Bot + Mini App",
  "main": "api/server.js",
  "scripts": {
    "start": "node api/server.js",
    "bot": "node bot/index.js",
    "dev": "nodemon api/server.js",
    "dev:bot": "nodemon bot/index.js",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:bot\""
  },
  "dependencies": {
    "better-sqlite3": "^9.6.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "^7.5.1",
    "node-cron": "^3.0.3",
    "node-telegram-bot-api": "^0.66.0",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.14"
  }
}
