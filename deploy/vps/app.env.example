# PantaUangmu secrets + settings for one VPS instance. Lives at /opt/panta/<name>/app.env (chmod 600).
# Format: KEY=value, one per line, NO quotes, NO ${{...}} Railway references (paste the real value).
# NODE_ENV, PORT and DB_PATH are set by compose.yml; do not add them here.

# ── Wajib ──
BOT_TOKEN=
WEBAPP_URL=
TIMEZONE=Asia/Jakarta

# ── Admin (/admin) ──
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Pakai nilai yang SAMA dengan di Railway: API key yang disimpan dari /admin dienkripsi dengan ini.
ADMIN_SESSION_SECRET=
AI_SECRET_KEY=
ADMIN_CONTACT=

# ── AI (salin dari Railway; ganti ${{AI_API_KEY}} dengan key aslinya) ──
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_FALLBACK_BASE_URL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=
AI_VISION_MODEL=
AI_AUDIO_MODEL=
AI_PRESETS=
AI_KEYS=
RECEIPTS_ENABLED=true
AI_SELFTEST=true

# ── Langganan ──
TRIAL_DAYS=7

# ── Backup harian ke /data/backups (di VPS). Opsional: salin juga ke bucket S3 gratis (mis. Cloudflare R2). ──
BACKUP_ENABLED=true
BACKUP_KEEP=7
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

LOG_LEVEL=info
